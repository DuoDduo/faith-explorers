# Copy to .env on the server and fill in every value. Never commit the real file.

# Your domain, pointed at this server with an A record (and www. if you want it).
DOMAIN=faithexplorers.org

# Database (only reachable inside Docker). Use a long random password.
POSTGRES_USER=faith
POSTGRES_PASSWORD=
POSTGRES_DB=faith_explorers

# Shared secret between the web server and the API. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Email via any SMTP provider (Brevo, Resend, Postmark, Mailgun, Gmail app password…).
EMAIL_FROM=Faith Explorers <hello@faithexplorers.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Where contact-form messages are forwarded (optional).
CONTACT_NOTIFY_EMAIL=
