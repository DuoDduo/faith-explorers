# Where the Next.js server reaches the FastAPI backend (server-side only; never sent to browsers).
API_URL=http://localhost:8000

# Public URL of this site, used for absolute links in page metadata, robots.txt and the
# sitemap. Needed at build time as well as at runtime.
SITE_URL=http://localhost:3000

# Shared secret sent to the API with each visitor's IP so rate limits apply per visitor.
# Must match the API's INTERNAL_API_KEY.
INTERNAL_API_KEY=change-me
