DATABASE_URL=postgresql+psycopg://faith:faith@localhost:5432/faith_explorers
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Shared secret the Next.js server sends with each visitor's IP, so rate limits apply
# per visitor rather than per web server. Use the same value as the frontend's INTERNAL_API_KEY.
INTERNAL_API_KEY=change-me

# Public URL of the website, used in links inside emails.
SITE_URL=http://localhost:3000

# Email: "console" prints emails to the log (development); "smtp" sends them.
EMAIL_BACKEND=console
EMAIL_FROM=Faith Explorers <no-reply@example.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Forward contact-form messages here (optional).
CONTACT_NOTIFY_EMAIL=
